# Literal KEY=value; blank lines and # comments supported.
# Single/double quotes supported; no escaping, expansion, export or multiline.
# Unquoted inline comments require a space before #. Indices need not be consecutive.
# Fill tokens in .env only. Empty tokens are skipped with a named warning.
CODECHALLENGE_BOT_1_NAME=arielcohen
CODECHALLENGE_BOT_1_TOKEN=

CODECHALLENGE_BOT_2_NAME=Charmander
CODECHALLENGE_BOT_2_TOKEN=
